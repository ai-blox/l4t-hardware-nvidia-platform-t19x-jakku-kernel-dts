/dts-v1/;
#include "common/tegra194-p3668-ai-blox-common.dtsi"
#include "common/tegra194-p3509-0000-a00.dtsi"
#include "common/tegra194-mx1030-1-gpio.dtsi"

&head0 {
    status = "disabled";
};

&sor1 {
    status = "disabled";
};

&sor1_hdmi_display {
    status = "disabled";
};

&head1 {
	status = "okay";
	nvidia,dc-connector = <&sor0>;
	nvidia,dc-flags = <TEGRA_DC_FLAG_ENABLED>;
};

&sor0 {
	status = "okay";
	nvidia,active-panel = <&sor0_hdmi_display>;
};

&sor0_hdmi_display {
	status = "okay";
	display-timings {
		1280x720-32-30Hz-37125000 {
			clock-frequency = <37125000>;
			hactive = <1280>;
			vactive = <720>;
			hfront-porch = <110>;
			hback-porch = <220>;
			hsync-len = <40>;
			vfront-porch = <5>;
			vback-porch = <20>;
			vsync-len = <5>;
			nvidia,h-ref-to-sync = <1>;
			nvidia,v-ref-to-sync = <1>;
		};
		1280x720-32-29_9Hz {
			clock-frequency = <35250000>;
			hactive = <1280>;
			vactive = <720>;
			hfront-porch = <40>;
			hback-porch = <160>;
			hsync-len = <120>;
			vfront-porch = <3>;
			vback-porch = <8>;
			vsync-len = <5>;
			nvidia,h-ref-to-sync = <1>;
			nvidia,v-ref-to-sync = <1>;
		};
		1280x720-32-60Hz {
			clock-frequency = <74250000>;
			hactive = <1280>;
			vactive = <720>;
			hfront-porch = <110>;
			hback-porch = <220>;
			hsync-len = <40>;
			vfront-porch = <5>;
			vback-porch = <20>;
			vsync-len = <5>;
			nvidia,h-ref-to-sync = <1>;
			nvidia,v-ref-to-sync = <1>;
		};
		1920x1080-32-30Hz {
			clock-frequency = <74250000>;
			hactive = <1920>;
			vactive = <1080>;
			hfront-porch = <88>;
			hback-porch = <148>;
			hsync-len = <44>;
			vfront-porch = <4>;
			vback-porch = <36>;
			vsync-len = <5>;
			nvidia,h-ref-to-sync = <1>;
			nvidia,v-ref-to-sync = <1>;
		};
	};
	disp-default-out {
		nvidia,out-flags = <TEGRA_DC_OUT_HOTPLUG_LOW>;
		nvidia,out-parent-clk = "plld2";
	};
};

/ {
	nvidia,dtsfilename = __FILE__;
	nvidia,dtbbuildtime = __DATE__, __TIME__;

	compatible = "nvidia,p3449-0000+p3668-0000", "nvidia,p3449-0000+p3668-0001", "nvidia,p3509-0000+p3668-0000", "nvidia,p3509-0000+p3668-0001", "nvidia,tegra194";

    thermal-fan-est {
        status = "disabled";
    };

    tachometer@39c0000 {
        status = "disbaled";
    };
};

&hdr40_i2c1 {
	tp2912@44 {
		compatible = "tp2912";
		reg = <0x44>;

		fhd-gpio = <&tegra_main_gpio TEGRA194_MAIN_GPIO(Q, 1) GPIO_ACTIVE_HIGH>;

		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			tp2912_in: endpoint {
				remote-endpoint = <&adv7611_out>;
			};
		};

		port@1 {
			reg = <1>;
		};
	};

	adv7611@4c {
		compatible = "adi,adv7611";
		reg = <0x4c>;

		reset-gpios = <&tegra_main_gpio TEGRA194_MAIN_GPIO(Q, 3) GPIO_ACTIVE_LOW>;

		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
		};

		port@1 {
			reg = <1>;
			adv7611_out: endpoint {
				remote-endpoint = <&tp2912_in>;
				default-input = <0>;
			};
		};
	};
};