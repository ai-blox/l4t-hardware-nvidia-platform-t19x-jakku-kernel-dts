/dts-v1/;
#include "common/tegra194-p3668-ai-blox-common.dtsi"
#include "common/tegra194-p3509-0000-a00.dtsi"
#include "common/tegra194-mx1030-1-gpio.dtsi"

&head0 {
    status = "disabled";
};

&sor1 {
    status = "disabled";
};

&sor1_hdmi_display {
    status = "disabled";
};

/ {
	nvidia,dtsfilename = __FILE__;
	nvidia,dtbbuildtime = __DATE__, __TIME__;

	compatible = "nvidia,p3449-0000+p3668-0000", "nvidia,p3449-0000+p3668-0001", "nvidia,p3509-0000+p3668-0000", "nvidia,p3509-0000+p3668-0001", "nvidia,tegra194";

    thermal-fan-est {
        status = "disabled";
    };

    tachometer@39c0000 {
        status = "disbaled";
    };
};

&hdr40_i2c1 {
	tp2912@44 {
		compatible = "tp2912";
		reg = <0x44>;

		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			tp2912_in: endpoint {
				remote-endpoint = <&adv7611_out>;
			};
		};

		port@1 {
			reg = <1>;
		};
	};

	adv7611@4c {
		compatible = "adi,adv7611";
		reg = <0x4c>;

		reset-gpios = <&tegra_main_gpio TEGRA194_MAIN_GPIO(Q, 3) GPIO_ACTIVE_LOW>;

		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
		};

		port@1 {
			reg = <1>;
			adv7611_out: endpoint {
				remote-endpoint = <&tp2912_in>;
				default-input = <0>;
			};
		};
	};
};